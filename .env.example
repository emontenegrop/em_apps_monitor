# Variables para docker compose. Copia este archivo a `.env` (no se versiona).

# Administrador inicial de la UI. Solo se crea si la BD no tiene usuarios.
# Mínimo 12 caracteres. Después del primer arranque, cambia la contraseña en
# "Mi cuenta" y borra ADMIN_PASSWORD de este archivo.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# URL pública del central: la usan los agentes y aparece en el comando de instalación
PUBLIC_URL=https://172.16.27.31:8443

# Clave para cifrar en la BD la contraseña SMTP de las notificaciones (32 bytes en base64).
# Generar una sola vez:  openssl rand -base64 32
# Si se pierde o cambia, hay que volver a escribir la contraseña SMTP en la UI.
SETTINGS_KEY=
